# IA opcional. El bot conserva las respuestas de sus reglas sin una clave.
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-5.6-luna
WHISPER_API_KEY=
GROQ_API_KEY=

# Acceso al panel. Definí una contraseña propia antes de iniciar.
ADMIN_EMAIL=admin@aitue.net
ADMIN_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# npm start activa el sitio integrado. npm run server permite usar Vite aparte.
SERVE_FRONTEND=false
WP_PORT=3001
PORT=3000
BOT_DEBUG=false
